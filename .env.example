# Backend público do Timbre (Go). Usado no servidor (SSR/ISR e rotas-proxy).
TIMBRE_API=https://timbre-api.sapienzalabs.com.br

# Storage de capas de evento (S3-compatível — Cloudflare R2, o mesmo do spa-sapienza).
# Sem estes valores, o upload de capa responde 503 e só a URL externa fica disponível.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=
