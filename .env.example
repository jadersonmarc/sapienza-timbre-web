# Backend público do Timbre (Go). Usado no servidor (SSR/ISR e rotas-proxy).
TIMBRE_API=https://timbre-api.sapienzalabs.com.br

# Storage de capas de evento (S3-compatível — Cloudflare R2, o mesmo do spa-sapienza).
# Sem estes valores, o upload de capa responde 503 e só a URL externa fica disponível.
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_URL=

# Busca de local (Google Places). OPCIONAL: sem ela o campo de local cai para digitação
# manual, que é caminho completo — local sem cadastro no Google precisa funcionar.
#
# A chave fica SÓ no servidor: o navegador chama /api/places, e é essa rota que fala com o
# Google. Restrinja a chave por IP (a saída do servidor), não por origem — restrição de
# origem só protege chave exposta, que é justamente o que este desenho evita.
#
# O autocompletar é cobrado POR SESSÃO: o campo abre um token de sessão no foco e o encerra
# na escolha, com debounce. Uma busca inteira custa uma sessão, não uma por tecla.
GOOGLE_MAPS_API_KEY=
